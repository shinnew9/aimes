# Copy to .env.local and fill in. .env* is gitignored, so this never reaches GitHub.

# --- OpenAI (every /api/* route uses this) ---
OPENAI_API_KEY=sk-...
NEXT_PUBLIC_OPENAI_API_KEY=sk-...

# --- Firebase (login + Firestore; the returning-patient feature needs this) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Hidden admin page (optional, not needed to test the feature) ---
NEXT_PUBLIC_SECRET_ADMIN_EMAIL=
NEXT_PUBLIC_SECRET_ADMIN_PASSWORD=
NEXT_PUBLIC_SECRET_URL_TOKEN=
